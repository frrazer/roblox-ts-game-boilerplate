{
  "name": "game-boilerplate-ts",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "serve": "rojo serve default.project.json --address 127.0.0.1",
    "lint": "eslint src",
    "format": "prettier --write src",
    "check": "prettier --write src && eslint src && rbxtsc && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && rojo build default.project.json --output build/code.rbxlx"
  },
  "dependencies": {
    "@flamework/components": "^1.3.2",
    "@flamework/core": "^1.3.2",
    "@flamework/networking": "^1.3.2",
    "@rbxts/charm": "^0.11.1",
    "@rbxts/charm-sync": "^0.4.1",
    "@rbxts/conch": "^0.3.1",
    "@rbxts/conch-ui": "^0.3.1",
    "@rbxts/janitor": "^1.18.3-ts.0",
    "@rbxts/pretty-react-hooks": "^0.6.4",
    "@rbxts/profile-store": "^1.0.3",
    "@rbxts/react": "^17.3.13-ts.1",
    "@rbxts/react-charm": "^0.4.1",
    "@rbxts/react-roblox": "^17.3.13-ts.1",
    "@rbxts/ripple": "^0.10.2",
    "@rbxts/services": "^1.6.0",
    "@rbxts/sift": "^0.0.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@rbxts/compiler-types": "^3.0.0-types.0",
    "@rbxts/types": "^1.0.960",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-roblox-ts": "^1.4.1",
    "prettier": "^3.9.10",
    "rbxts-transformer-flamework": "^1.3.2",
    "roblox-ts": "^3.0.0",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.72.1"
  }
}
